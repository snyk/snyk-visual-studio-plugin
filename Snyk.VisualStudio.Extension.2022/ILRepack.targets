<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="CollectSerilogMergeInputs" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <SerilogMergeInput Include="@(ReferencePath)" Condition="'%(Extension)' == '.dll' And ('%(Filename)' == 'Serilog' Or '%(Filename)' == 'Serilog.Sinks.File' Or '%(Filename)' == 'Serilog.Enrichers.Process' Or '%(Filename)' == 'Serilog.Enrichers.Thread' Or '%(Filename)' == 'Serilog.Exceptions')" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Serilog' Or '%(Filename)' == 'Serilog.Sinks.File' Or '%(Filename)' == 'Serilog.Enrichers.Process' Or '%(Filename)' == 'Serilog.Enrichers.Thread' Or '%(Filename)' == 'Serilog.Exceptions'" />
    </ItemGroup>
  </Target>
  <Target Name="MergeSerilogIntoExtension" AfterTargets="CoreCompile" DependsOnTargets="CollectSerilogMergeInputs" Inputs="@(IntermediateAssembly);@(SerilogMergeInput)" Outputs="$(IntermediateOutputPath)serilog-merge.stamp">
    <PropertyGroup>
      <SerilogMergeDir>$(IntermediateOutputPath)serilog-merge\</SerilogMergeDir>
    </PropertyGroup>
    <ItemGroup>
      <SerilogMergeLibRaw Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(SerilogMergeLibRaw)">
      <Output TaskParameter="Filtered" ItemName="SerilogMergeLib" />
    </RemoveDuplicates>
    <RemoveDir Directories="$(SerilogMergeDir)" />
    <MakeDir Directories="$(SerilogMergeDir)" />
    <ILRepack Parallel="true" Internalize="false" DebugInfo="true" TargetKind="Dll" InputAssemblies="@(IntermediateAssembly);@(SerilogMergeInput)" LibraryPath="@(SerilogMergeLib)" OutputFile="$(SerilogMergeDir)$(TargetFileName)" />
    <Copy SourceFiles="$(SerilogMergeDir)$(TargetFileName)" DestinationFiles="@(IntermediateAssembly)" />
    <Copy Condition="Exists('$(SerilogMergeDir)$(TargetName).pdb')" SourceFiles="$(SerilogMergeDir)$(TargetName).pdb" DestinationFolder="$(IntermediateOutputPath)" />
    <Touch Files="$(IntermediateOutputPath)serilog-merge.stamp" AlwaysCreate="true" />
  </Target>
</Project>
